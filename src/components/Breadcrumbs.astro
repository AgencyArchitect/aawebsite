---
interface Props {
  trail: { name: string; url: string }[];
}

const { trail } = Astro.props;
const siteUrl = 'https://agencyarchitect.nl';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.url, siteUrl).href,
  })),
};
---

<nav aria-label="Kruimelpad" class="breadcrumbs">
  <ol>
    {
      trail.map((crumb, i) => (
        <li>
          {i < trail.length - 1 ? (
            <a href={crumb.url}>{crumb.name}</a>
          ) : (
            <span aria-current="page">{crumb.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<style>
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(0.2rem, 1.5vw, var(--space-xs));
    font-size: clamp(0.62rem, 2.65vw, var(--text-sm));
    color: var(--color-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    inline-size: 100%;
    min-inline-size: 0;
  }

  .breadcrumbs {
    display: block;
    max-inline-size: 100%;
    min-inline-size: 0;
    overflow: hidden;
  }

  .breadcrumbs li {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breadcrumbs li:last-child {
    flex: 1 1 auto;
  }

  @media (max-width: 47.99rem) {
    .breadcrumbs ol {
      font-size: clamp(0.58rem, 2.45vw, 0.75rem);
      line-height: 1.35;
      gap: 0.18rem;
    }

    .breadcrumbs li:not(:last-child)::after {
      margin-inline-start: 0.18rem;
    }
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-inline-start: clamp(0.2rem, 1.5vw, var(--space-xs));
    color: var(--color-accent-warm);
  }

  .breadcrumbs a {
    color: var(--color-ink-soft);
  }

  .breadcrumbs [aria-current] {
    color: var(--color-ink);
  }
</style>
