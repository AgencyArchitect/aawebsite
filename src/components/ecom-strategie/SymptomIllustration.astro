---
/**
 * Vier lijn-illustraties (één per symptoom), in de huisstijl: ink-lijnen,
 * warm accent, geen rasters of kleurvlakken. `variant` kiest de tekening.
 */
interface Props {
  variant: 'gokken' | 'gevoel' | 'metrics' | 'concurrentie';
}
const { variant } = Astro.props;
---

{
  variant === 'gokken' && (
    <svg viewBox="0 0 120 90" role="img" aria-label="Illustratie: dobbelstenen, groei als gok" class="symptom-art">
      <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="14" y="26" width="38" height="38" rx="8" transform="rotate(-8 33 45)" />
        <circle cx="26" cy="38" r="3" fill="currentColor" stroke="none" />
        <circle cx="40" cy="52" r="3" fill="currentColor" stroke="none" />
        <rect x="62" y="30" width="38" height="38" rx="8" transform="rotate(6 81 49)" />
        <path d="M74 42c2-3 6-3 8 0M74 56c2 3 6 3 8 0" stroke="var(--color-accent-warm)" />
        <path d="M60 12v14M52 18l8 8 8-8" stroke="var(--color-accent-warm)" />
        <path d="M18 76h84" stroke-dasharray="2 6" />
      </g>
    </svg>
  )
}
{
  variant === 'gevoel' && (
    <svg viewBox="0 0 120 90" role="img" aria-label="Illustratie: kompas zonder vaste richting" class="symptom-art">
      <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="60" cy="45" r="30" />
        <path d="M60 15v6M60 69v6M30 45h6M84 45h6" />
        <path d="M48 57 60 30l12 27-12-8z" stroke="var(--color-accent-warm)" />
        <path d="M60 30v-8" stroke="var(--color-accent-warm)" stroke-dasharray="2 4" />
      </g>
    </svg>
  )
}
{
  variant === 'metrics' && (
    <svg viewBox="0 0 120 90" role="img" aria-label="Illustratie: formules met 404-foutmelding" class="symptom-art">
      <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="16" y="16" width="88" height="58" rx="6" />
        <path d="M28 32h14M50 32h8M28 44h8M42 44h14M62 44h6M28 56h18" />
        <rect x="70" y="36" width="26" height="18" rx="4" stroke="var(--color-accent-warm)" />
        <path d="M76 45h2M81 45h2M86 45h2" stroke="var(--color-accent-warm)" stroke-width="3" />
      </g>
    </svg>
  )
}
{
  variant === 'concurrentie' && (
    <svg viewBox="0 0 120 90" role="img" aria-label="Illustratie: krimpende cirkel met veel spelers" class="symptom-art">
      <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="60" cy="45" r="32" stroke-dasharray="4 5" />
        <circle cx="60" cy="45" r="20" />
        <circle cx="60" cy="45" r="9" stroke="var(--color-accent-warm)" />
        <circle cx="26" cy="24" r="4" />
        <circle cx="94" cy="26" r="4" />
        <circle cx="98" cy="62" r="4" />
        <circle cx="24" cy="64" r="4" />
      </g>
    </svg>
  )
}

<style>
  .symptom-art {
    inline-size: 100%;
    max-inline-size: 9rem;
    color: var(--color-ink);
    opacity: 0.9;
  }
</style>
