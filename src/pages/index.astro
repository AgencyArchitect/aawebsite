---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditCTA from '../components/AuditCTA.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Hero22 from '../components/ui/Hero22.tsx';
import SplitFlapText from '../components/ui/SplitFlapText.jsx';
import ComparisonBlock from '../components/ui/comparison-2.tsx';
import WorkflowCards from '../components/WorkflowCards.tsx';
import { getPublishedArticles } from '../lib/site';

const articles = (await getPublishedArticles()).filter((a) =>
  ['waarom-je-beste-ad-je-grootste-risico-is', 'cpa-stijgt-nieuwe-creatives-niet-oplossing', 'de-hook-is-geen-zin-maar-een-hypothese'].includes(a.id),
);
---

<BaseLayout
  title="Agency Architect"
  description="Growth consultancy voor creative Meta advertising. Voor founders van gezonde e-commerce merken die willen schalen zonder te gokken op de volgende creative."
>
  <!-- 1. Hero -->
  <Hero22 client:load />

  <!-- 2. Split Flap board -->
  <section class="section splitflap-section" aria-labelledby="splitflap-heading">
    <div class="container splitflap-section__inner">
      <h2 id="splitflap-heading" class="section-title splitflap-section__title">
        Herkenbaar?
      </h2>
      <SplitFlapText
        client:load
        words={['HOGE ATC', 'ROAS <2,5', 'MEER BUDGET', 'MEER CREATIVES', 'AD FATIGUE']}
        flipDuration={0.12}
        stagger={0.06}
        cycleDelay={2400}
        charset="alphanumeric"
        flipsPerChar={8}
        tileColor="#faf8f5"
        textColor="#001d51"
        tileRadius={10}
        gap={6}
        fontSize="clamp(1.5rem, 4.5vw, 3.2rem)"
        loop
        padTo={13}
      />

      <div class="splitflap-section__copy">
              <p class="splitflap-section__lede">
                Voor webshops die winstgevend zijn, maar moeite hebben om performance op te schalen uit Meta advertenties.
              </p>
              <div class="splitflap-section__cols">
                <div class="splitflap-section__col">
                  <p>
                    Als de <strong>ROAS lager is dan 2,5</strong>, dan ben je niet te laat. Maar juist aan het begin.
                  </p>
                  <p>
                    Bij een te lage ROAS — of een schommelende ROAS — ervaren brands een lagere, onvoorspelbare
                    winstmarge. En hebben daardoor minder buffer en budget, om op te schalen.
                  </p>
                  <p>
                    Brands verliezen hiermee hun publiek. En de concurrentie wint die doelgroep die geen performance meer bediend wordt.
                  </p>
                  <p>
                    In plaats van te fixen wat er misgaat, zien brands nieuwe creatives, geleend geld of nieuwe
                    producten/offers testen als de oplossing.
                  </p>
                </div>
                <div class="splitflap-section__col">
                  <p class="splitflap-section__key">
                    Om erachter te komen dat dat het niet is.
                  </p>
                  <p>
                    Marketing voelt als gokken. Concurrentie groeit. En brands raken onzeker over hun eigen toekomst.
                  </p>
                  <p>
                    Doelen en investeringen worden uitgesteld, targets niet gehaald en je betaalt jezelf als laatste uit.
                    Dit is niet nodig.
                  </p>
                  <p class="splitflap-section__closing">
                    Het ligt niet aan de brand en het product. Maar aan de creative strategy en het systeem achter de brand.
                  </p>
                </div>
              </div>
            </div>
    </div>
  </section>

  <!-- 3. De diensten waarmee Agency Architect dit uitvoert -->
  <section class="section section--wash pillars-section" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="pillars-copy pillars-copy--beige">
        <p class="pillars-copy__lede">
          Creative strategy voor brands hoeft niet ingewikkeld te zijn. Het is schaalbaar weten wat er
          getest wordt. Gebaseerd op persona's, offers en invalshoeken/angles, die vooraf bepaald zijn.
        </p>

        <div class="pillars-copy__cols">
          <div class="pillars-copy__col">
            <p>
              Voor e-commerce brands die willen opschalen: ze zijn te druk om dit zelf te doen.
            </p>
            <p>
              Eigenaren zijn al druk met finance, webshop aanpassingen, customer support, leveranciers
              vinden en meer. Ads moeten daar ook nog bij passen. Dat werkt niet.
            </p>
            <p>
              Het alternatief? Een freelancer of een agency. Al lijkt het in het begin goed te gaan;
              beiden doen ook geen creative strategy.
            </p>
            <p>
              Helaas zien brands niks meer dan copy-paste concepten, goede excusjes en matig voldoende
              resultaten.
            </p>
            <p>
              E-commerce brands die willen opschalen hebben niks aan een agency of freelancer, die
              hetzelfde trucje kopieert van hun andere klanten.
            </p>
          </div>
          <div class="pillars-copy__col">
            <p>
              En daar komt Agency Architect om de hoek kijken.
            </p>
            <p>
              Waar freelancers goed zijn in media buying, mist het component creatives. Qua ideatie en
              product- en marktonderzoek.
            </p>
            <p>
              En waar agencies dat wel doen voor e-commerce brands, mist het gevoel van klant zijn.
              Veel copy-paste werk — zelfs in de WhatsApp en Slack berichten die accountmanagers rondsturen.
            </p>
            <p class="pillars-copy__key">
              En nog belangrijker: Hoe kunnen e-commerce brands opschalen, met een strategie die niet van hun is?
              En die ze zelf niet eens begrijpen?
            </p>
          </div>
        </div>

        <div class="pillars-closing">
                  <div class="pillars-closing__text">
                    <p>
                      Agency Architect helpt e-commerce brands opschalen door een merkeigen creative strategy te
                      bepalen — samen met de eigenaar. En deze vervolgens ook uit te voeren.
                    </p>
                    <p>
                      Geen kopieer-plakwerk. Geen eenmalige campagnes en concepten. Samen vinden we unieke
                      concepten, die schaalbaar zijn. En niet eenmalig goed werken. Met winst, vrijheid en
                      voorspelbare groei als doel.
                    </p>
                    <p class="pillars-copy__concept">
                      Zodat e-commerce founders weer concentreren op wat ertoe doet: familie, droomleven en de
                      wereld veroveren.
                    </p>
                  </div>
                  <div class="pillars-closing__art">
                              <svg class="cirkel" viewBox="0 0 460 460" role="img" aria-label="Cirkeldiagram: Creative strategy, Media buying en Tracking &amp; Reporting sluiten op elkaar aan">
                                <defs>
                                  <marker id="cirkelArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                    <path d="M0 0 10 5 0 10z" fill="var(--color-accent-warm)" />
                                  </marker>
                                </defs>
                                <circle cx="230" cy="230" r="150" fill="none" stroke="var(--color-border)" stroke-width="1.5" stroke-dasharray="3 6" />
                                <g class="cirkel__flow" fill="none" stroke="var(--color-accent-warm)" stroke-width="2" stroke-linecap="round" marker-end="url(#cirkelArrow)">
                                  <path d="M230 80 A150 150 0 0 1 380 230" />
                                  <path d="M380 230 A150 150 0 0 1 230 380" />
                                  <path d="M230 380 A150 150 0 0 1 80 230" />
                                  <path d="M80 230 A150 150 0 0 1 230 80" />
                                </g>
                                <g font-family="var(--font-sans)" font-weight="600" text-anchor="middle">
                                  <g>
                                    <circle cx="230" cy="80" r="50" fill="var(--color-ink)" />
                                    <text x="230" y="75" fill="var(--color-on-ink)" font-size="12.5">Creative</text>
                                    <text x="230" y="91" fill="var(--color-on-ink)" font-size="12.5">strategy</text>
                                  </g>
                                  <g>
                                    <circle cx="380" cy="230" r="50" fill="var(--color-ink)" />
                                    <text x="380" y="225" fill="var(--color-on-ink)" font-size="12.5">Media</text>
                                    <text x="380" y="241" fill="var(--color-on-ink)" font-size="12.5">buying</text>
                                  </g>
                                  <g>
                                    <circle cx="230" cy="380" r="50" fill="var(--color-ink)" />
                                    <text x="230" y="385" fill="var(--color-on-ink)" font-size="13">Creative</text>
                                  </g>
                                  <g>
                                    <circle cx="80" cy="230" r="50" fill="var(--color-ink)" />
                                    <text x="80" y="228" fill="var(--color-on-ink)" font-size="12">Tracking &amp;</text>
                                    <text x="80" y="244" fill="var(--color-on-ink)" font-size="12">Reporting</text>
                                  </g>
                                </g>
                                <text x="230" y="222" text-anchor="middle" font-family="var(--font-serif)" font-style="italic" font-size="19.5" fill="var(--color-ink-soft)">Agency</text>
                                <text x="230" y="244" text-anchor="middle" font-family="var(--font-serif)" font-style="italic" font-size="19.5" fill="var(--color-ink-soft)">Architect</text>
                              </svg>
                            </div>
                </div>
      </div>

      <div class="diensten-block">
        <p class="eyebrow">De diensten</p>
        <h2 id="pillars-heading" class="section-title">Disciplines waarmee Agency Architect dit uitvoert:</h2>

        <div class="grid-2 pillar-grid">
          <article class="pillar">
            <h3 class="pillar__title">
              <a href="/e-commerce-marketing/">E-commerce marketing</a>
            </h3>
            <p class="text-soft pillar__desc">
              De volledige marketing-aanpak voor webshops die winstgevend willen schalen: strategie, creatives, media buying en rapportage als één systeem.
            </p>
            <a class="pillar__cta" href="/e-commerce-marketing/">Bekijk de aanpak →</a>
          </article>
          <article class="pillar">
            <h3 class="pillar__title">
              <a href="/e-commerce-marketing/instagram-marketing/adverteren/">Instagram advertising</a>
            </h3>
            <p class="text-soft pillar__desc">
              Adverteren op Instagram als ontdekkings- en bewijskanaal, binnen dezelfde merkeigen creative strategy.
            </p>
            <a class="pillar__cta" href="/e-commerce-marketing/instagram-marketing/adverteren/">Bekijk de aanpak →</a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. De oplossing: waarom Agency Architect anders is -->
  <ComparisonBlock client:load />

  <!-- 5. Zo werk ik -->
  <section class="section werkwijze-section" aria-labelledby="werkwijze-heading">
    <div class="container werkwijze-section__inner">
      <p class="eyebrow">Zo werk ik</p>
      <h2 id="werkwijze-heading" class="section-title">Vier stappen</h2>

      <ol class="werkwijze">
        <WorkflowCards client:load />
      </ol>
    </div>
  </section>

  <!-- 6. Kennisbank -->
  <section class="section section--wash" aria-labelledby="kennisbank-heading">
    <div class="container">
      <div class="kennisbank__head">
        <div>
          <p class="eyebrow">Kennisbank</p>
          <h2 id="kennisbank-heading" class="section-title">Inzichten</h2>
        </div>
        <a class="kennisbank__all" href="/inzichten/">Alle inzichten →</a>
      </div>

      {articles.map((article) => (
        <ArticleCard {article} />
      ))}
    </div>
  </section>

  <!-- 7. CTA -->
  <AuditCTA
    heading="Weten waar je staat?"
    body="We beoordelen de schaalbaarheid van je Meta- en creative-aanpak — en waar je volgende euro het meest onderbouwd heen kan."
  />
</BaseLayout>

<style is:global>
  /* Split Flap sectie (na de hero) */
  .splitflap-section {
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: var(--space-2xl) var(--space-3xl);
    overflow: hidden;
  }
  .splitflap-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .splitflap-section__eyebrow {
    color: var(--color-on-ink-soft);
    margin-inline: auto;
  }
  .splitflap-section__title {
    margin-block: var(--space-xs) var(--space-lg);
    max-inline-size: 20ch;
  }
  .splitflap-section .split-flap-text {
    max-inline-size: 100%;
    overflow-x: auto;
    margin-inline: auto;
    justify-content: center;
  }

  .splitflap-section__copy {
    margin-inline: auto;
    margin-block-start: var(--space-xl);
    color: var(--color-on-ink-soft);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.92rem + 0.25vw, 1.12rem);
    line-height: 1.65;
    text-align: left;
  }
  .splitflap-section__copy p {
    margin-block: var(--space-sm);
  }
  .splitflap-section__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md) var(--space-2xl);
    margin-block-start: var(--space-md);
  }
  .splitflap-section__col > * + * {
    margin-block-start: var(--space-sm);
  }
  .splitflap-section__copy strong {
    color: var(--color-on-ink);
    font-weight: 700;
  }
  .splitflap-section__lede {
    max-inline-size: 62ch;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.45rem);
    line-height: 1.4;
    color: var(--color-on-ink);
    font-weight: 600;
    margin-block-end: var(--space-md);
  }
  .splitflap-section__key {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.28rem);
    color: var(--color-on-ink);
    font-weight: 600;
  }
  .splitflap-section__closing {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.28rem);
    color: var(--color-on-ink);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .splitflap-section__copy {
      text-align: left;
    }
    .splitflap-section__cols {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* AnimatedList (zelfde styling als op de e-commerce strategie-pagina,
     hier globaal zodat het React-eiland in de hero het bereikt). */
  .anim-list {
    position: relative;
    display: grid;
    gap: clamp(0.4rem, 1vw, 0.6rem);
    padding-block: clamp(0.35rem, 0.8vw, 0.5rem);
  }
  .anim-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.6rem, 1.2vw, 0.75rem);
    background-color: var(--color-white);
    border: var(--border-hairline);
    border-radius: clamp(0.8rem, 1.6vw, 1.4rem);
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.9rem, 1.6vw, 1.1rem);
    box-shadow: 0 8px 24px rgba(0, 29, 81, 0.1);
  }
  .anim-new-badge {
    position: absolute;
    inset-block-start: -0.42rem;
    inset-inline-end: -0.42rem;
    inline-size: 1.365rem;
    block-size: 1.365rem;
    border-radius: 50%;
    background-color: #e02424;
    border: 2px solid var(--color-white);
  }
  .anim-dot {
    flex-shrink: 0;
    inline-size: clamp(0.55rem, 0.9vw, 0.65rem);
    block-size: clamp(0.55rem, 0.9vw, 0.65rem);
    border-radius: 50%;
    margin-block-start: 0.4rem;
  }
  .anim-logo {
    flex-shrink: 0;
    inline-size: clamp(1.35rem, 2.4vw, 1.6rem);
    block-size: clamp(1.35rem, 2.4vw, 1.6rem);
    object-fit: contain;
    margin-block: auto;
  }
  .anim-source {
    font-size: clamp(0.68rem, 0.6rem + 0.2vw, 0.83rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-warm);
  }
  .anim-title {
    font-weight: 600;
    font-size: clamp(0.82rem, 0.72rem + 0.3vw, 0.95rem);
    margin-block-start: 0.15rem;
  }
  .anim-text {
    font-size: clamp(0.78rem, 0.7rem + 0.25vw, 0.9rem);
    color: var(--color-ink-soft);
    margin-block-start: 0.15rem;
  }
  .anim-time {
    margin-inline-start: auto;
    font-size: clamp(0.66rem, 0.58rem + 0.2vw, 0.8rem);
    color: var(--color-ink-soft);
    flex-shrink: 0;
  }

  /* Shared section heading */
  .section-title {
    margin-block: var(--space-xs) var(--space-xl);
  }

  /* 2. Pijlers */
  .pillar-grid {
    margin-block-start: var(--space-lg);
  }

  .pillar {
    border-block-start: var(--border-hairline);
    padding-block: var(--space-lg);
  }

  .pillar__title a {
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillar__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pillar__desc {
    margin-block: var(--space-sm);
    max-inline-size: var(--width-content);
  }

  .pillar__cta {
    display: inline-block;
    margin-block-start: var(--space-lg);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillar__cta:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pillars-copy {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-2xl);
    border-block-start: var(--border-hairline);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.92rem + 0.25vw, 1.12rem);
    line-height: 1.65;
  }
  .pillars-copy--beige {
    background: #f6f4f0;
    border-block-start: 0;
    border-radius: 24px;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    margin-block-start: 0;
    margin-block-end: var(--space-2xl);
  }
  .pillars-copy--beige .pillars-closing {
    border-block-start-color: var(--color-border, #d9dde6);
  }

  .diensten-block {
    background: #001d51;
    border-radius: 24px;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    color: #fff;
    position: relative;
    isolation: isolate;
    z-index: 2;
  }
  .diensten-block .eyebrow {
    color: var(--color-on-ink-soft);
  }
  .diensten-block .section-title {
    color: #fff;
  }
  .diensten-block .pillar-grid {
    position: relative;
    z-index: 1;
  }
  .diensten-block .pillar__title a,
  .diensten-block .pillar__cta {
    color: #fff;
    position: relative;
    z-index: 5;
    display: inline-block;
    cursor: pointer;
    pointer-events: auto;
  }
  .diensten-block .pillar__desc {
    color: rgba(255, 255, 255, 0.75);
  }
  .diensten-block .pillar {
    border-block-start-color: rgba(255, 255, 255, 0.2);
    position: relative;
  }
  .diensten-block .pillar__cta {
    margin-block-start: var(--space-md);
  }
  .pillars-copy p {
    margin-block: var(--space-sm);
  }
  .pillars-copy strong {
    color: var(--color-accent-warm);
    font-weight: 700;
  }
  .pillars-copy__lede {
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.45rem);
    line-height: 1.4;
    color: var(--color-ink);
    font-weight: 600;
    max-inline-size: var(--width-content);
    margin-block-end: var(--space-md);
  }
  .pillars-copy__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md) var(--space-2xl);
    margin-block-start: var(--space-md);
  }
  .pillars-copy__col > * + * {
    margin-block-start: var(--space-sm);
  }
  .pillars-copy__key {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.28rem);
    color: var(--color-ink);
    font-weight: 600;
  }
  .pillars-closing {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--border-hairline);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .pillars-closing__text p {
    margin-block: var(--space-sm);
    max-inline-size: var(--width-content);
  }
  .pillars-closing__art {
    display: flex;
    justify-content: center;
  }

  /* ---------- Cirkel / 4 disciplines-cyclus ----------
     Zelfde stijl als de "De cirkel"-animatie op de strategie-pagina. */
  .cirkel {
    display: block;
    inline-size: min(100%, 24rem);
    max-inline-size: 24rem;
    margin-inline: auto;
  }
  /* Bewegende pijlen: de flow trekt subtiel richting de volgende donkerblauwe cirkel. */
  .cirkel__flow path {
    stroke-dasharray: 12 260;
    stroke-dashoffset: 260;
    animation: cirkel-flow 4s linear infinite;
  }
  .cirkel__flow path:nth-child(2) {
    animation-delay: -1s;
  }
  .cirkel__flow path:nth-child(3) {
    animation-delay: -2s;
  }
  .cirkel__flow path:nth-child(4) {
    animation-delay: -3s;
  }
  @keyframes cirkel-flow {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cirkel__flow path {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
  .pillars-copy__concept {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.28rem);
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .pillars-copy__cols {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .pillars-closing {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* 3. Zo werk ik — vaste stapelkaarten (actieve stap in donkerblauw) */
  .werkwijze-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .werkwijze-section .section-title {
    text-align: center;
  }
  .werkwijze {
    list-style: none;
    margin: 0;
    padding: 0;
    max-inline-size: var(--width-wide);
    inline-size: 100%;
  }
  .wf {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .wf__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    inline-size: min(100%, 48rem);
  }
  .wf__card {
    display: grid;
    grid-template-columns: auto 1fr;
