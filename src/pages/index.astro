---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditCTA from '../components/AuditCTA.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Hero22 from '../components/ui/Hero22.tsx';
import { SITE, getLiveTopics, getPublishedArticles, topicUrl } from '../lib/site';

const topics = await getLiveTopics();
const platforms = topics.filter((t) => t.data.level === 'platform');

const articles = (await getPublishedArticles()).filter((a) =>
  ['waarom-je-beste-ad-je-grootste-risico-is', 'cpa-stijgt-nieuwe-creatives-niet-oplossing', 'de-hook-is-geen-zin-maar-een-hypothese'].includes(a.id),
);
---

<BaseLayout
  title="Agency Architect"
  description="Growth consultancy voor creative Meta advertising. Voor founders van gezonde e-commerce merken die willen schalen zonder te gokken op de volgende creative."
>
  <!-- 1. Hero -->
  <Hero22 client:load />

  <!-- 2. Twee pijlers voor e-commerce groei -->
  <section class="section section--wash" aria-labelledby="pillars-heading">
    <div class="container">
      <p class="eyebrow">Twee pijlers voor e-commerce groei</p>
      <h2 id="pillars-heading" class="section-title">Waar we in groeien</h2>

      <div class="grid-2 pillar-grid">
        {
          platforms.map((platform) => (
            <article class="pillar">
              <h3 class="pillar__title">
                <a href={topicUrl(platform)}>{platform.data.title}</a>
              </h3>
              <p class="text-soft pillar__desc">{platform.data.description}</p>
              <a class="pillar__cta" href={topicUrl(platform)}>Bekijk de aanpak →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Zo werk ik -->
  <section class="section" aria-labelledby="werkwijze-heading">
    <div class="container">
      <p class="eyebrow">Zo werk ik</p>
      <h2 id="werkwijze-heading" class="section-title">Vier stappen</h2>

      <ol class="werkwijze">
        <li class="werkwijze__step">
          <span class="werkwijze__nr" aria-hidden="true">01</span>
          <div>
            <h3>Analyse</h3>
            <p class="text-soft">
              We duiken in je Meta-ad account en toetsen de markt. Markt- en productonderzoek, en
              dat balen we samen tot één unieke creative strategy voor jouw merk.
            </p>
          </div>
        </li>
        <li class="werkwijze__step">
          <span class="werkwijze__nr" aria-hidden="true">02</span>
          <div>
            <h3>Strategie</h3>
            <p class="text-soft">
              We bespreken de strategie én jouw echte doel: hoe vliegen we dit aan, waar wil je
              heen — ook internationaal. Eerst akkoord, dan pas bouwen.
            </p>
          </div>
        </li>
        <li class="werkwijze__step">
          <span class="werkwijze__nr" aria-hidden="true">03</span>
          <div>
            <h3>Uitvoering</h3>
            <p class="text-soft">
              We schalen één campagne of land op en maken het proces overzichtelijk — zodat het
              daarna op élke campagne en land toepasbaar is. Een groeimachine.
            </p>
          </div>
        </li>
        <li class="werkwijze__step">
          <span class="werkwijze__nr" aria-hidden="true">04</span>
          <div>
            <h3>Meten &amp; schalen</h3>
            <p class="text-soft">
              Elke maand: nieuwe campagnes, producten, concurrent-acquisitie, cashflow. Blijven
              groeien, stap voor stap.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. Kennisbank -->
  <section class="section section--wash" aria-labelledby="kennisbank-heading">
    <div class="container">
      <div class="kennisbank__head">
        <div>
          <p class="eyebrow">Kennisbank</p>
          <h2 id="kennisbank-heading" class="section-title">Inzichten</h2>
        </div>
        <a class="kennisbank__all" href="/inzichten/">Alle inzichten →</a>
      </div>

      {articles.map((article) => (
        <ArticleCard {article} />
      ))}
    </div>
  </section>

  <!-- 5. CTA -->
  <AuditCTA
    heading="Weten waar je staat?"
    body="We beoordelen de schaalbaarheid van je Meta- en creative-aanpak — en waar je volgende euro het meest onderbouwd heen kan."
  />
</BaseLayout>

<style is:global>
  /* AnimatedList (zelfde styling als op de e-commerce strategie-pagina,
     hier globaal zodat het React-eiland in de hero het bereikt). */
  .anim-list {
    position: relative;
    display: grid;
    gap: clamp(0.4rem, 1vw, 0.6rem);
    padding-block: clamp(0.35rem, 0.8vw, 0.5rem);
  }
  .anim-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.6rem, 1.2vw, 0.75rem);
    background-color: var(--color-white);
    border: var(--border-hairline);
    border-radius: clamp(0.8rem, 1.6vw, 1.4rem);
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.9rem, 1.6vw, 1.1rem);
    box-shadow: 0 8px 24px rgba(0, 29, 81, 0.1);
  }
  .anim-new-badge {
    position: absolute;
    inset-block-start: -0.42rem;
    inset-inline-end: -0.42rem;
    inline-size: 1.365rem;
    block-size: 1.365rem;
    border-radius: 50%;
    background-color: #e02424;
    border: 2px solid var(--color-white);
  }
  .anim-dot {
    flex-shrink: 0;
    inline-size: clamp(0.55rem, 0.9vw, 0.65rem);
    block-size: clamp(0.55rem, 0.9vw, 0.65rem);
    border-radius: 50%;
    margin-block-start: 0.4rem;
  }
  .anim-logo {
    flex-shrink: 0;
    inline-size: clamp(1.35rem, 2.4vw, 1.6rem);
    block-size: clamp(1.35rem, 2.4vw, 1.6rem);
    object-fit: contain;
    margin-block: auto;
  }
  .anim-source {
    font-size: clamp(0.68rem, 0.6rem + 0.2vw, 0.83rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-warm);
  }
  .anim-title {
    font-weight: 600;
    font-size: clamp(0.82rem, 0.72rem + 0.3vw, 0.95rem);
    margin-block-start: 0.15rem;
  }
  .anim-text {
    font-size: clamp(0.78rem, 0.7rem + 0.25vw, 0.9rem);
    color: var(--color-ink-soft);
    margin-block-start: 0.15rem;
  }
  .anim-time {
    margin-inline-start: auto;
    font-size: clamp(0.66rem, 0.58rem + 0.2vw, 0.8rem);
    color: var(--color-ink-soft);
    flex-shrink: 0;
  }

  /* Shared section heading */
  .section-title {
    margin-block: var(--space-xs) var(--space-xl);
  }

  /* 2. Pijlers */
  .pillar-grid {
    margin-block-start: var(--space-lg);
  }

  .pillar {
    border-block-start: var(--border-hairline);
    padding-block: var(--space-lg);
  }

  .pillar__title a {
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillar__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pillar__desc {
    margin-block: var(--space-sm);
    max-inline-size: var(--width-content);
  }

  .pillar__cta {
    display: inline-block;
    margin-block-start: var(--space-lg);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillar__cta:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* 3. Zo werk ik */
  .werkwijze {
    list-style: none;
    margin: 0;
    padding: 0;
    max-inline-size: var(--width-wide);
  }

  .werkwijze__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-block-start: var(--border-hairline);
  }

  .werkwijze__nr {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-accent-warm);
    min-inline-size: 2.5ch;
  }

  .werkwijze__step h3 {
    font-size: var(--text-xl);
  }

  .werkwijze__step .text-soft {
    margin-block-start: var(--space-xs);
    max-inline-size: var(--width-content);
  }

  /* 4. Kennisbank */
  .kennisbank__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-md);
  }

  .kennisbank__head .section-title {
    margin-block: var(--space-xs) 0;
  }

  .kennisbank__all {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .kennisbank__all:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
</style>
